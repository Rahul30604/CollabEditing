# CollabEditor Production Environment Variables
# Copy this to .env and fill in your values

# MySQL
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=collabeditor
MYSQL_USER=collabuser
MYSQL_PASSWORD=collabpass

# RabbitMQ
RABBITMQ_USER=collabuser
RABBITMQ_PASS=collabpass

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here

# Gemini (optional)
GEMINI_API_KEY=your-gemini-key-here
